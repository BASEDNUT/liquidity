{
    "build": {
        "env": {
            "VENICE_API_KEY": "@venice_api_key"
        }
    },
    "version": 2,
    "builds": [
        {
            "src": "next.config.js",
            "use": "@vercel/next"
        },
        {
            "src": "pages/**/*",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/chat",
            "dest": "/chat"
        }
    ]
}
