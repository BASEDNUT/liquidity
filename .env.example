# Server-side secrets (never commit real values)
# Venice AI
VENICE_API_KEY=
VENICE_CHAT_MODEL=default-reasoning
VENICE_IMAGE_MODEL_DEFAULT=flux-dev
VENICE_IMAGE_MODELS=flux-dev,stable-diffusion-3.5,fluently-xl

# Redis (optional, required if warmachine/Redis features enabled)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# n8n (Orchard TVL)
N8N_WEBHOOK_URL=
NEXT_PUBLIC_FEATURE_ORCHARD_SIGN_ENABLED=true

# Feature flags
FEATURE_AI_ENABLED=true
FEATURE_IMAGE_GEN_ENABLED=true
FEATURE_WARMACHINE_ENABLED=true
FEATURE_ORCHARD_SIGN_ENABLED=true

# Runtime controls
REQUEST_TIMEOUT_MS=120000
LOG_LEVEL=info
CORS_ORIGIN=*

# Cron/refresh
CRON_REFRESH_TOKEN=
ORCHARD_REFRESH_URL=
